{
  "backend": {
    "type": "cuda",
    "device": 0
  },
  "dataloader": {
    "type": "async",
    "data_type": "float32"
  },
  "dataset": {
    "root_path": "/data/gaussian-splatting/360_v2_converted/bicycle/train/",
    "extension": "JPG",
    "resolution": -1,
    "resolution_scale": 1.0,
    "type": "image"
  },
  "test_dataset": {
    "root_path": "/data/gaussian-splatting/360_v2_converted/bicycle/val/",
    "extension": "JPG",
    "resolution": -1,
    "resolution_scale": 1.0,
    "type": "image"
  },
  "initializer": {
    "default_distance": 0.01,
    "enable_radius_outlier_removal": false,
    "init_opacity": 0.1,
    "init_scaling": 1,
    "use_anisotropic": true,
    "min_distance": 1.0e-07,
    "nb_points": 24,
    "num_neighbors": 16,
    "radius": 0.1,
    "sh_degree": 3,
    "type": "knn"
  },
  "losses": [
    {
      "type": "l1",
      "weight": 0.8
    },
    {
      "type": "fused_ssim",
      "weight": 0.2
    }
  ],
  "lr_schedulers": {
    "means": {
      "initial_lr": 1.0,
      "position_lr_final": 0.01,
      "position_lr_delay_mult": 0.01,
      "position_lr_max_steps": 30000,
      "use_fastgs_schedule": true,
      "type": "exponential"
    },
    "shs": {
      "type": "constant"
    },
    "opacities": {
      "type": "constant"
    },
    "scales": {
      "type": "constant"
    },
    "rotations": {
      "type": "constant"
    }
  },
  "metrics": [
    "psnr"
  ],
  "optimizer": {
    "epsilon": 1.0e-10,
    "max_grad_1": 1.0,
    "means_lr": 0.00016,
    "opacities_l1": 0.0,
    "opacities_lr": 0.05,
    "rotations_lr": 0.001,
    "scales_l1": 0.00,
    "scales_lr": 0.005,
    "shs_lr": 0.0025,
    "sh1_lr_scale": 0.05,
    "sh2_lr_scale": 0.05,
    "sh3_lr_scale": 0.05,
    "skip_zero_grad": false,
    "weight_decay": 0.0,
    "type": "adam"
  },
  "pose_opt": {
    "type": "adamw",
    "lr": 0.0,
    "momentum": 0.95,
    "beta1": 0.9,
    "beta2": 0.999,
    "epsilon": 1.0e-8,
    "weight_decay": 0.1
  },
  "rasterizer": {
    "type": "fastgs"
  },
  "strategy": {
    "duplicate_grad_threshold": 0.0002,
    "absgrad": true,
    "loss_thresh": 0.06,
    "prune_degenerate_rotation": true,
    "duplicate_scale_threshold": 0.005,
    "end_refine": 15000,
    "max_num_gaussians": 3000000,
    "max_screen_size": 10,
    "pruning_opacity_threshold": 0.005,
    "pruning_scale_threshold": 0.1,
    "refine_every": 500,
    "reset_every": 3000,
    "reset_reset_optimizer": false,
    "seed": 42,
    "start_refine": 100,
    "noise_lr_init": 8.0,
    "split_distance": 0.45,
    "opacity_reduction": 0.6,
    "opacity_reset_value": 0.01,
    "type": "mcmc",
    "absgrad_threshold": 0.0008
  },
  "trainer": {
    "means_accumulate_grad_steps": 1,
    "shs_accumulate_grad_steps": 16,
    "opacities_accumulate_grad_steps": 1,
    "scales_accumulate_grad_steps": 1,
    "rotations_accumulate_grad_steps": 1,
    "train_data_type": "float32",
    "eval_data_type": "float32",
    "checkpoint_interval": 1000,
    "early_stopping_patience": 1000,
    "early_stopping_threshold": 1.0e-6,
    "enable_early_stopping": false,
    "far_plane": 100.0,
    "grad_scaler": 1.0,
    "log_interval": 100,
    "max_sh_degree": 3,
    "max_steps": 30000,
    "near_plane": 0.01,
    "sh_degree_interval": 1000,
    "scene_scale_recompute_interval": 1000,
    "reorder_gaussians_interval": 1000,
    "start_pose_opt": 50000,
    "record_trajectory": false,
    "test_steps": [
      3000,
      7000,
      10000,
      15000,
      30000
    ],
    "out_dir": "outputs",
    "export_rasterized": true,
    "max_seconds": 240
  }
}