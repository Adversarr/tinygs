# Modified from: https://gist.github.com/trxcllnt/dad9565a1cfd54aedbe8fcf052a7cd45
CompileFlags:
  Add:     # 要额外添加到 Clang 的 NVCC 没有的参数
    - --no-cuda-version-check
  Remove:  # 移除 Clang 不认识的 NVCC 参数
    - -forward-unknown-to-host-compiler
    - --expt-*
    - --generate-code=*
    - -arch=*
    - -rdc=*
    # strip CUDA fatbin args
    - "-Xcompiler=*"
    - "-Xfatbin*"
    # strip CUDA arch flags
    # - "-gencode*"
    # - "--generate-code*"
    # strip CUDA flags unknown to clang
    - "--extended-lambda"
    - "-ccbin*"
    - "--compiler-options*"
    - "--expt-extended-lambda"
    - "--expt-relaxed-constexpr"
    - "-forward-unknown-to-host-compiler"
    - "-Werror=cross-execution-space-call"

Index:
  Background: Build

Completion:
  AllScopes: No

Diagnostics:
  UnusedIncludes: Strict

InlayHints:
  BlockEnd: No
  Designators: Yes
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes
  TypeNameLimit: 24

Hover:
  ShowAKA: No
